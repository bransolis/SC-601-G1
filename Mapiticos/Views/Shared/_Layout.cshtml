<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mapiticos</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@3/dist/tabler-icons.min.css" />
    <link rel="stylesheet" href="~/css/mapiticos.css" asp-append-version="true" />
</head>
<body>
    @{
        var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
        var conSesion = User.Identity?.IsAuthenticated == true && ViewData["OcultarMenu"] as bool? != true;
    }
    <div class="app @(conSesion ? "con-menu" : "")">
        <main class="app-contenido">
            @RenderBody()
        </main>

        @if (conSesion)
        {
            <nav class="nav-inferior" aria-label="Navegación principal">
                <a asp-controller="Feed" asp-action="Index" class="nav-logo">
                    <img src="~/img/logo.png" alt="Mapiticos, ir al inicio" />
                </a>
                <a asp-controller="Mapa" asp-action="Index"
                   class="nav-item @(controlador == "Mapa" ? "activo" : "")"
                   aria-current="@(controlador == "Mapa" ? "page" : null)">
                    <span class="nav-icono"><i class="ti ti-map"></i></span>Mapa
                </a>
                <a asp-controller="Feed" asp-action="Index"
                   class="nav-item @(controlador == "Feed" ? "activo" : "")"
                   aria-current="@(controlador == "Feed" ? "page" : null)">
                    <span class="nav-icono"><i class="ti ti-photo"></i></span>Feed
                </a>
                <a asp-controller="Favoritos" asp-action="Index"
                   class="nav-item @(controlador == "Favoritos" ? "activo" : "")"
                   aria-current="@(controlador == "Favoritos" ? "page" : null)">
                    <span class="nav-icono"><i class="ti ti-star"></i></span>Favoritos
                </a>
                <a asp-controller="Notificaciones" asp-action="Index"
                   class="nav-item @(controlador == "Notificaciones" ? "activo" : "")"
                   aria-current="@(controlador == "Notificaciones" ? "page" : null)">
                    <span class="nav-icono"><i class="ti ti-bell"></i></span>
                    <span class="nav-punto" aria-label="Avisos sin leer"></span>Avisos
                </a>
                <a asp-controller="Perfil" asp-action="Index"
                   class="nav-item @(controlador == "Perfil" ? "activo" : "")"
                   aria-current="@(controlador == "Perfil" ? "page" : null)">
                    <span class="nav-icono"><i class="ti ti-user"></i></span>Perfil
                </a>
            </nav>
        }
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>